<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/keymap_builder_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true"
    android:background="#F7F8FA"
    android:orientation="vertical">

    <LinearLayout
        android:id="@+id/keymap_builder_top_area"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="16dp"
        android:paddingTop="12dp"
        android:paddingEnd="16dp"
        android:paddingBottom="4dp">

        <TextView
            android:id="@+id/keymap_builder_header"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/keymap_builder_activity_title"
            android:textColor="#17202A"
            android:textSize="20sp"
            android:textStyle="bold" />

    </LinearLayout>

    <LinearLayout
        android:id="@+id/keymap_builder_name_row"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginTop="4dp"
        android:layout_marginEnd="16dp"
        android:background="#FFFFFF"
        android:elevation="2dp"
        android:gravity="center_vertical"
        android:minHeight="48dp"
        android:orientation="horizontal"
        android:padding="6dp">

        <TextView
            android:id="@+id/keymap_builder_name_row_number"
            android:layout_width="28dp"
            android:layout_height="36dp"
            android:gravity="center"
            android:text="0"
            android:textColor="#667085"
            android:textSize="13sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/keymap_builder_name_key"
            android:layout_width="0dp"
            android:layout_height="36dp"
            android:layout_marginStart="6dp"
            android:layout_marginEnd="6dp"
            android:layout_weight="1"
            android:background="#EEF2F6"
            android:gravity="center_vertical"
            android:paddingStart="10dp"
            android:paddingEnd="10dp"
            android:text="@string/keymap_builder_name_key_fixed"
            android:textColor="#475467"
            android:textSize="13sp" />

        <EditText
            android:id="@+id/keymap_builder_name_input"
            android:layout_width="0dp"
            android:layout_height="36dp"
            android:layout_weight="1"
            android:hint="@string/keymap_builder_name_hint"
            android:inputType="text"
            android:paddingStart="10dp"
            android:paddingEnd="10dp"
            android:singleLine="true"
            android:textColor="#17202A"
            android:textColorHint="#98A2B3"
            android:textSize="13sp" />

    </LinearLayout>

    <!-- Compact search/filter row: comma-separated terms, matched
         (OR across terms) against either the output or the keys field
         of each row, depending on the radio selection. Combines with
         the duplicate-only checkbox below (AND) - see
         apply_row_filters() in KeymapBuilderActivity. -->
    <LinearLayout
        android:id="@+id/keymap_builder_search_row"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginTop="6dp"
        android:layout_marginEnd="16dp"
        android:background="#FFFFFF"
        android:elevation="2dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="6dp">

        <EditText
            android:id="@+id/keymap_builder_search_input"
            android:layout_width="0dp"
            android:layout_height="36dp"
            android:layout_marginEnd="6dp"
            android:layout_weight="1"
            android:hint="@string/keymap_builder_search_hint"
            android:inputType="text"
            android:paddingStart="10dp"
            android:paddingEnd="10dp"
            android:singleLine="true"
            android:textColor="#17202A"
            android:textColorHint="#98A2B3"
            android:textSize="13sp" />

        <RadioGroup
            android:id="@+id/keymap_builder_search_radio_group"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <RadioButton
                android:id="@+id/keymap_builder_search_output_radio"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:checked="true"
                android:text="@string/keymap_builder_search_output"
                android:textColor="#475467"
                android:textSize="11sp" />

            <RadioButton
                android:id="@+id/keymap_builder_search_keys_radio"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:text="@string/keymap_builder_search_keys"
                android:textColor="#475467"
                android:textSize="11sp" />

        </RadioGroup>

    </LinearLayout>

    <LinearLayout
        android:id="@+id/keymap_builder_column_header"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginTop="8dp"
        android:layout_marginEnd="16dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="8dp"
        android:paddingEnd="8dp">

        <TextView
            android:layout_width="28dp"
            android:layout_height="wrap_content"
            android:text=""
            android:textSize="11sp" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:layout_marginEnd="6dp"
            android:layout_weight="1"
            android:text="@string/keymap_builder_output_column"
            android:textColor="#667085"
            android:textSize="11sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="2"
            android:text="@string/keymap_builder_keys_column"
            android:textColor="#667085"
            android:textSize="11sp"
            android:textStyle="bold" />

    </LinearLayout>

    <ScrollView
        android:id="@+id/keymap_builder_mapping_scroll"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:fillViewport="true"
        android:paddingStart="16dp"
        android:paddingTop="4dp"
        android:paddingEnd="16dp"
        android:paddingBottom="8dp"
        android:scrollbars="vertical">

        <LinearLayout
            android:id="@+id/keymap_builder_rows_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />

    </ScrollView>

    <!-- Fixed "quick add" section: lets the user append a row without
         scrolling to the bottom of a long list, and hosts the toggle/
         import/export buttons. -->
    <LinearLayout
        android:id="@+id/keymap_builder_quick_add_section"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginTop="6dp"
        android:layout_marginEnd="16dp"
        android:background="#FFFFFF"
        android:elevation="2dp"
        android:orientation="vertical"
        android:padding="6dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <EditText
                android:id="@+id/keymap_builder_quick_output"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginEnd="6dp"
                android:layout_weight="1"
                android:hint="@string/keymap_builder_output_hint"
                android:inputType="textMultiLine"
                android:minHeight="40dp"
                android:textSize="13sp" />

            <EditText
                android:id="@+id/keymap_builder_quick_keys"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginEnd="6dp"
                android:layout_weight="2"
                android:hint="@string/keymap_builder_keys_hint"
                android:inputType="text"
                android:minHeight="40dp"
                android:singleLine="true"
                android:textSize="13sp" />

            <ImageButton
                android:id="@+id/keymap_builder_quick_add_button"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:background="@android:color/transparent"
                android:contentDescription="@string/keymap_builder_quick_add_button"
                android:src="@android:drawable/ic_input_add" />

        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:gravity="center_vertical|end"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/keymap_builder_instructions"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/keymap_builder_instructions"
                android:textColor="#667085"
                android:textSize="11sp" />

            <CheckBox
                android:id="@+id/keymap_builder_solo_duplicates_checkbox"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:enabled="false"
                android:text="@string/keymap_builder_solo_duplicates"
                android:textColor="#667085"
                android:textSize="10sp" />

            <ImageButton
                android:id="@+id/keymap_builder_import_json_button"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_marginStart="10dp"
                android:background="@android:color/transparent"
                android:contentDescription="@string/keymap_builder_import_json_title"
                android:padding="2dp"
                android:src="@android:drawable/ic_menu_upload" />

            <ImageButton
                android:id="@+id/keymap_builder_raw_json_button"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_marginStart="6dp"
                android:background="@android:color/transparent"
                android:contentDescription="@string/keymap_builder_raw_json_title"
                android:padding="2dp"
                android:src="@android:drawable/ic_menu_edit" />

        </LinearLayout>

    </LinearLayout>

    <Button
        android:id="@+id/keymap_builder_create_button"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginTop="6dp"
        android:layout_marginEnd="16dp"
        android:layout_marginBottom="12dp"
        android:minHeight="46dp"
        android:text="@string/keymap_builder_create"
        android:textAllCaps="false"
        android:textSize="14sp" />

</LinearLayout>